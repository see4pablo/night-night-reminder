# Night Night Reminder — Android / Kotlin shell
# Enter with: nix-shell
#
# Accepts Android SDK licenses and exposes JDK + a composed SDK.
# Emulator is optional (heavy); enable includeEmulator if you want it.
{ pkgs ? import <nixpkgs> {
    config = {
      allowUnfree = true;
      android_sdk.accept_license = true;
    };
  }
}:

let
  buildToolsVersion = "34.0.0";
  platformVersion = "34";

  androidComposition = pkgs.androidenv.composeAndroidPackages {
    cmdLineToolsVersion = "13.0";
    platformToolsVersion = "36.0.2";
    buildToolsVersions = [ buildToolsVersion ];
    platformVersions = [ platformVersion ];
    abiVersions = [ "x86_64" "armeabi-v7a" "arm64-v8a" ];
    includeEmulator = false;
    includeSystemImages = false;
    includeNDK = false;
    useGoogleAPIs = false;
  };

  androidSdk = androidComposition.androidsdk;
  jdk = pkgs.jdk17;
in
pkgs.mkShell {
  name = "night-night-reminder";

  packages = [
    jdk
    androidSdk
    androidComposition.platform-tools
    pkgs.gradle
  ];

  JAVA_HOME = jdk.home;
  ANDROID_HOME = "${androidSdk}/libexec/android-sdk";
  ANDROID_SDK_ROOT = "${androidSdk}/libexec/android-sdk";

  # Use Nix store aapt2 so Gradle does not need FHS for the packaged binary.
  GRADLE_OPTS = "-Dorg.gradle.project.android.aapt2FromMavenOverride=${androidSdk}/libexec/android-sdk/build-tools/${buildToolsVersion}/aapt2";

  shellHook = ''
    export PATH="$ANDROID_HOME/platform-tools:$PATH"
    cat > local.properties <<EOF
# Generated by nix-shell — do not commit.
sdk.dir=$ANDROID_HOME
EOF
    echo "night-night-reminder — Android SDK ready"
    echo "  JAVA_HOME=$JAVA_HOME"
    echo "  ANDROID_HOME=$ANDROID_HOME"
    echo "Build:  ./gradlew :app:assembleDebug"
    echo "Install on device:  ./gradlew :app:installDebug"
  '';
}
